###############################################
# Staging config checklist for Remote Desktop Backend #
#
# This is NOT loaded automatically - it's a reference for filling out the
# real .env on the staging server. Same field set as .env.example (see that
# file's header for the sync convention with apps/app/core/settings.py); this
# version just swaps local-dev defaults for staging-appropriate values and
# <placeholder> markers for anything that needs a real staging credential.
#
# Anywhere you see <placeholder>, replace it with the real value before use -
# this file is not valid to `cp` straight to `.env` and run.
###############################################

# --- Database ---
PG_DB_NAME=remote_desktop
PG_DB_USER=<staging db user>
PG_DB_PASSWORD=<staging db password>   # Set your own password
PG_DB_HOST=<staging host>
PG_DB_PORT=<staging port>
PG_DUMP_PATH=<replicate the same to dev server>


# --- Server ---
# ENVIRONMENT gates the local auth bypass below - keep it "local" only on your machine.
ENVIRONMENT=staging
APP_NAME=remote-desktop-backend
# APP_ENV is informational only (logged on startup) - it does NOT gate the local
# auth bypass, ENVIRONMENT does that. Keep both in sync to avoid confusion.
APP_ENV=staging
APP_VERSION=0.1.0
LOG_LEVEL=INFO
PORT=<server main port where api run>
HOST=<server main host where api run>
# Used only by run/scripts/start.py (local dev) - port for the standalone
# monitor service (apps/monitor/main.py). Docker uses MONITOR_BASE_URL
# instead (docker-compose.yml's `monitor` service already hardcodes 8001).
MONITOR_PORT=<server monitor port, in sync with monitor port on docker>

# --- CORS & trusted hosts ---
# List-type vars below use JSON array syntax (pydantic-settings parses env vars
# as JSON), e.g. CORS_ORIGINS=["https://staging.example.com"]
#
# This is a real deployment, not local dev - do NOT leave these as "*". Lock
# them down to the actual staging domains, or any site can call this API from
# a user's browser:
TRUSTED_HOSTS=["<staging api domain>"]
CORS_ORIGINS=["<staging web domain>"]
CORS_ALLOW_CREDENTIALS=true   # must stay true - auth is an HttpOnly cookie, not a bearer token
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
CORS_EXPOSE_HEADERS=[]

# --- Celery/Redis ---
# If you run via docker-compose: these two are also ignored - every service
# hardcodes redis://redis:6379/0 in docker-compose.yml's `environment:` block
# (Compose's environment: always wins over env_file: .env). Only matters if
# you run the app directly on the staging server (no Docker).
#
# CONFIRM before reusing dev's broker here: if staging points at the exact
# same Redis instance/db as dev, task queues, cache keys, and the WebSocket
# invalidation channel below all mix across environments. Either give staging
# its own Redis (or at least its own db index, e.g. .../1), or make
# CACHE_PREFIX / TASK_METADATA_KEY_PREFIX / WS_INVALIDATION_CHANNEL further
# down environment-specific.
CELERY_BROKER_URL=<replicate the same to dev server>
CELERY_RESULT_BACKEND=<replicate the same to dev server>

# --- JWT ---
# NEVER reuse dev's secret and never expose this value. Generate a fresh one via:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<jwt secret>
# How long the JWT/access-token cookie stays valid, in minutes.
JWT_ACCESS_TOKEN_MINUTES=60
JWT_ALGORITHM=HS256

# --- General-purpose secret encryption (e.g. device/session secrets at rest) ---
# NEVER reuse dev's key and never expose this value. Generate a fresh one via:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Once staging has real encrypted secrets in its DB, do not rotate this
# without a migration - existing rows become undecryptable.
SECRET_ENCRYPTION_KEY=<secret encryption key>

# --- File reference encryption (opaque refs for downloadable files) ---
# NEVER reuse dev's key and never expose this value. Generate a fresh one via:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Same rotation caveat as SECRET_ENCRYPTION_KEY above.
FILE_REFERENCE_ENCRYPTION_KEY=<file reference secret key>

# --- Impersonation (temporary POC - apps/app/modules/impersonation) ---
IMPERSONATION_LEASE_TTL_SECONDS=20
IMPERSONATION_MAX_LIFETIME_SECONDS=10800

# --- URLs ---
BASE_URL=http://<staging api domain>/
WEB_URL=http://<staging web domain>/
API_PREFIX=/api
# Standalone monitor service (apps/monitor/main.py) - separate process/port
# from the main API, see docker-compose.yml's `monitor` service.
MONITOR_BASE_URL=http://<staging monitor domain>/
# Kill switch for the whole Dev Monitoring service. false blocks new token
# generation (python -m run.admin generate) and makes every monitor-service
# endpoint reject requests the same way an invalid/expired token would.
MONITOR_ENABLED=true

# --- Okta SSO ---
SSO_LOGIN_URL=<replicate the same to dev server>
# Okta certs are usually per-Okta-application, not per-environment - if
# staging uses the same Okta app as dev, copy dev's okta.cert file onto the
# staging server and point this at its path there.
OKTA_CERT=<replicate the same to dev server>   # Path to the Okta certificate on the staging server
OKTA_REDIRECT_TO=okta/login
OKTA_IDP=<replicate the same to dev server>

# --- Local dev auth bypass (LOCAL ONLY) ---
# Only takes effect when ENVIRONMENT=local. When set, GET /api/okta/login skips
# the real Okta SAML flow and logs you in as this email (creating the user if
# it doesn't exist yet). Leave empty to go through real Okta SSO as normal.
# Never set this in dev/staging/prod environments.
DEFAULT_USER_EMAIL=

# --- Auth cookie ---
# The access token is delivered as an HttpOnly cookie instead of being readable
# by the browser app's JavaScript.
AUTH_COOKIE_NAME=access_token
# Staging is a real https deployment - this MUST be true (unlike .env.example's
# local-dev default of false), or browsers silently drop the cookie entirely.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# Only set this if the frontend and API live on different subdomains of the
# same parent domain (e.g. app.example.com and api.example.com -> example.com).
AUTH_COOKIE_DOMAIN=<staging parent domain, if applicable - otherwise leave empty>

# --- AWS / S3 (attachment uploads, API log archival) ---
# CONFIRM whether staging shares dev's S3 bucket or has its own. If shared,
# S3_ATTACHMENT_PREFIX already namespaces by environment (staging below) - but
# the API/analysis log S3 prefixes further down do NOT, so a shared bucket
# would mix staging and dev logs under the same log prefixes.
AWS_ACCESS_KEY_ID=<staging value>
AWS_SECRET_ACCESS_KEY=<staging value>
AWS_REGION=us-east-1
S3_BUCKET_NAME=<staging value>
S3_ATTACHMENT_PREFIX=remote-desktop-backend/staging/attachments

# --- Email (SMTP) ---
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_USER=<staging value - confirm whether staging gets its own SES credentials or reuses dev's>
MAIL_PASS=<staging value - confirm whether staging gets its own SES credentials or reuses dev's>
MAIL_PORT=587
# Default recipient(s) for system alert emails (log-export notices, etc.) when
# no explicit recipient is given. JSON array of addresses,
# e.g. ["qa@yourorg.com","oncall@yourorg.com"].
MAIL_DEFAULT_TO=[]

# --- Cache ---
CACHE_PREFIX=remote-desktop-backend   # see the Redis-sharing note above the Celery/Redis section
CACHE_EXPIRE_SECONDS=86400
CACHE_DISABLE=false

# --- API log retention ---
API_LOG_RETENTION_SECONDS=7200
API_LOG_S3_PREFIX=api-logs
API_LOG_S3_GROUPED_PREFIX=api-logs/grouped
# Individual API logs older than this are bundled into grouped archives before
# being sent to S3 (seconds).
API_LOG_S3_GROUP_AFTER_SECONDS=2592000
API_LOG_S3_RETENTION_SECONDS=31536000

# --- Local log export ("Archive" tab in Task Monitor - emails today's
# not-yet-archived local log files on request) ---
LOCAL_LOG_EXPORT_S3_PREFIX=api-logs/on-demand-export/selection
LOCAL_LOG_EXPORT_TOKEN_TTL_SECONDS=1800
LOCAL_LOG_EXPORT_DOWNLOAD_EXPIRES_IN_SECONDS=60

# --- Task runs ---
# How long completed task-run records are kept before cleanup (seconds).
TASK_RUN_RETENTION_SECONDS=5184000
MAX_RUNNING_TASKS=10
# A task with no heartbeat for this long is considered stuck by the scheduler (seconds).
SCHEDULER_STALE_TASK_TIMEOUT_SECONDS=172800
TASK_WATCHDOG_GRACE_PERIOD_SECONDS=300
TASK_METADATA_KEY_PREFIX=remote-desktop-backend:_task_metadata_:

# --- Analysis logs ---
ANALYSIS_LOG_RETENTION_SECONDS=604800
ANALYSIS_LOG_S3_PREFIX=analysis-logs
# "Email logs to devs" - a temporary export, independent from the retention above.
ANALYSIS_LOG_EXPORT_S3_PREFIX=analysis-logs/temp
ANALYSIS_LOG_EXPORT_TOKEN_TTL_SECONDS=1800
ANALYSIS_LOG_EXPORT_DOWNLOAD_EXPIRES_IN_SECONDS=60

# --- Monitor (Dev Monitoring service tuning) ---
MONITOR_TOKEN_TTL_SECONDS=3600
MONITOR_TOKEN_IDLE_TIMEOUT_SECONDS=1800
MONITOR_WEB_PATH=/monitor-admin/task-monitor
# JSON array of proxy IPs trusted to set X-Forwarded-For in front of the monitor
# service, e.g. ["10.0.0.1"]. Set to your staging reverse proxy/load balancer's
# IP - empty means no proxy is trusted (X-Forwarded-For is ignored entirely).
MONITOR_TRUSTED_PROXY_IPS=[]
MONITOR_WS_INVALIDATION_CHANNEL=monitor:ws:invalidate
MONITOR_RATE_LIMIT_WINDOW_SECONDS=300
MONITOR_RATE_LIMIT_MAX_REQUESTS=200
# TTL for X-Access-Key gates issued to monitor access requests (seconds).
MONITOR_ACCESS_KEY_TTL_SECONDS=86400
# IP-rate-limit for unauthenticated monitor access requests (see
# apps/app/modules/monitor/services/monitor_access_guard.py).
MONITOR_ACCESS_REQUEST_MAX_UNAUTHENTICATED=3
MONITOR_ACCESS_REQUEST_WINDOW_SECONDS=1800
MONITOR_ACCESS_REQUEST_BLOCK_SECONDS=1800

# --- WebSocket ---
WS_INVALIDATION_CHANNEL=ws:invalidate

# --- Rate limiting ---
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_MAX_REQUESTS=20
PUBLIC_RATE_LIMIT_COOLDOWN_SECONDS=300
USER_RATE_LIMIT_WINDOW_SECONDS=60
USER_RATE_LIMIT_MAX_REQUESTS=200
USER_BLOCK_DURATION_SECONDS=300

# --- Request log ---
REQUEST_LOG_SESSION_BUFFER_TTL_SECONDS=1800
USER_REQUEST_LOG_SUMMARY_RETENTION_DAYS=30

# --- Log redaction ---
# Field names stripped/masked from logs (see apps/app/core/logging.py). Only
# override this if you're adding a new sensitive field - removing an entry
# here means that field starts appearing in plaintext logs.
LOG_REDACT_LIST=["jwt_secret","okta_cert","pg_db_user","pg_db_password","pg_db_host","mail_user","mail_pass","celery_broker_url","celery_result_backend","aws_access_key_id","aws_secret_access_key","secret_encryption_key","file_reference_encryption_key"]

# --- AWS S3 (feature request uploads) ---
# NOTE: redundant with the AWS / S3 block above - aws_region, aws_access_key_id,
# and aws_secret_access_key are declared in both places in settings.py, and both
# read the same AWS_REGION/AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars either
# way. Expected to be consolidated with the main AWS block soon.
AWS_S3_FEATURE_REQUEST_UPLOADS=FEATURE-REQUEST-UPLOADS
AWS_S3_FEATURE_REQUEST_UPLOADS_URL=<staging value, if this feature is enabled on staging>
